  "passive_loading_counterexample": {
    "network": "No active feedback. Rth from feedback side to AC ground, Cin from gate side to AC ground, series source Vgate-Vfb=1.",
    "KCL": "Vfb/Rth + s Cin Vgate = 0",
    "ratio": "-Vfb/Vgate = s Rth Cin",
    "Rth_ohm": 8947.368421052632,
