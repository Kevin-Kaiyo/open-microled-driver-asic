  ORIGIN 0.000 0.300 ;
  SIZE 95.000 BY 37.660 ;
  PIN VSS
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER Metal3 ;
        RECT 0.000 -0.300 95.000 0.300 ;
    END
  END VSS
  PIN bias
    DIRECTION INOUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 80.000000 ;
    ANTENNADIFFAREA 9.679999 ;
    PORT
      LAYER Metal3 ;
        RECT 0.000 1.700 95.000 2.300 ;
    END
  END bias
  PIN gate
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    ANTENNAGATEAREA 80.000000 ;
    ANTENNADIFFAREA 1.760000 ;
    PORT
      LAYER Metal3 ;
        RECT 0.000 3.700 95.000 4.300 ;
    END
  END gate
