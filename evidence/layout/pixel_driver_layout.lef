    ANTENNAGATEAREA 2.000000 ;
    ANTENNADIFFAREA 2.640000 ;
    PORT
      LAYER Metal3 ;
        RECT 0.000 7.700 95.000 8.300 ;
    END
  END pwm_b
  PIN led_k
